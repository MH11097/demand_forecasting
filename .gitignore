# Data — giữ data/ trên git để share, chỉ ignore raw data nặng
results/
data/raw/*.csv
data/raw/*.7z
# Cache clean+zero-fill: chia sẻ train_cleaned.feather (zstd ~72MB) để mọi người dùng
# chung, KHỎI xử lý lại; các feather khác vẫn ignore.
*.feather
!data/cleaned/train_cleaned.feather

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.venv/
*.whl

# Models & artifacts — file model nặng, không đẩy lên git
*.pt
*.pth
*.ckpt
*.pkl
*.joblib
*.h5
*.hdf5
*.onnx
*.safetensors
*.bin

